{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VGDD 司法の判定（judge・Codex judge が返す形）。vgdd.verdict.v1。OpenAI の構造化出力（strict）の制約に合わせ、全プロパティを required に入れ、任意の項目は null を許す。const は enum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdict", "deterministic_audits_passed", "requirements", "findings", "summary"],
  "properties": {
    "schema": { "type": "string", "enum": ["vgdd.verdict.v1"] },
    "verdict": { "type": "string", "enum": ["APPROVED", "CHANGES_REQUIRED"] },
    "deterministic_audits_passed": { "type": "boolean" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["met", "not_met", "unverified"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "file", "line", "requirement_id", "reason"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "category": { "type": "string", "enum": ["requirement", "correctness", "security", "test", "protected_path", "input"] },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "requirement_id": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
